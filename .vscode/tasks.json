{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-kayraexport-api",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/kayraexport/src/KayraExport.API/KayraExport.API.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "publish-kayraexport-api",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/kayraexport/src/KayraExport.API/KayraExport.API.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch-kayraexport-api",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/kayraexport/src/KayraExport.API/KayraExport.API.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
