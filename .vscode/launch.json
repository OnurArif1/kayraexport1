{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "KayraExport.API (Product API)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-kayraexport-api",
            "program": "${workspaceFolder}/kayraexport/src/KayraExport.API/bin/Debug/net9.0/KayraExport.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/kayraexport/src/KayraExport.API",
            "console": "internalConsole",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:6165"
            }
        }
    ]
}
